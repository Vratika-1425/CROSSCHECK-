# ---------------------------------------------------------------------------
# CrossCheck frontend configuration
# ---------------------------------------------------------------------------

# Base path for the CrossCheck API.
# In production CloudFront serves the API on the same domain, so the default
# same-origin "/api" is correct and this can be left unset.
# For local dev, point it at the deployed HttpApi endpoint from `cdk deploy`:
# VITE_API_BASE_URL=https://abc123.execute-api.ap-south-1.amazonaws.com

# Set to "false" to run entirely on the bundled demo dataset with no backend.
# VITE_API_ENABLED=true

# Used only by the Vite dev-server proxy when VITE_API_BASE_URL is unset.
# VITE_API_PROXY_TARGET=https://abc123.execute-api.ap-south-1.amazonaws.com
